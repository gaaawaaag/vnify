{
  "name": "vnify",
  "version": "0.2.0",
  "description": "vnify. 小说视觉化：本地制作、配图与阅读",
  "author": "vnify",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node scripts/prompts.mjs --build",
    "start": "node src/server/server.mjs",
    "typecheck": "tsc -p . && tsc -p src/manager",
    "manager:build": "vite build --config src/manager/vite.config.mjs",
    "manager": "npm run manager:build && npm start",
    "prompts:build": "node scripts/prompts.mjs --build",
    "prompts:check": "node scripts/prompts.mjs --check",
    "validate": "node scripts/validate.mjs",
    "number-source": "node scripts/number-source.mjs",
    "apply-patches": "node scripts/apply-patches.mjs",
    "cutout": "node scripts/cutout.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
