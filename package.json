{
  "name": "vnify",
  "productName": "vnify",
  "version": "0.1.0",
  "description": "vnify. 小说视觉化：本地制作、配图与阅读",
  "author": "vnify",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node scripts/prompts.mjs --build",
    "start": "node src/server/server.mjs",
    "typecheck": "tsc -p . && tsc -p src/manager",
    "manager:build": "vite build --config src/manager/vite.config.mjs",
    "manager": "npm run manager:build && npm start",
    "prompts:build": "node scripts/prompts.mjs --build",
    "prompts:check": "node scripts/prompts.mjs --check",
    "validate": "node scripts/validate.mjs",
    "number-source": "node scripts/number-source.mjs",
    "apply-patches": "node scripts/apply-patches.mjs",
    "cutout": "node scripts/cutout.mjs",
    "desktop": "node scripts/prompts.mjs --build && electron .",
    "dist": "node scripts/prompts.mjs --check && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "25.1.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "src/desktop/main.mjs",
  "build": {
    "appId": "app.vnify",
    "productName": "vnify",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "package.json",
      "index.html",
      "src/**/*",
      "styles/**/*",
      "assets/**/*",
      "examples/**/*",
      "!src/server/server.mjs",
      "!node_modules/sharp/**/*",
      "!node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-setup.${ext}",
      "shortcutName": "vnify."
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
