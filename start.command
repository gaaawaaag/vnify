#!/bin/bash
cd "$(dirname "$0")"

echo "======================================"
echo "  墨间 · 视觉小说播放器 (macOS 启动脚本)"
echo "======================================"
echo "正在启动本地服务..."
echo "访问地址: http://127.0.0.1:4173"
echo "提示: 关闭此窗口或按 Ctrl+C 可停止服务"
echo "======================================"

# 延迟 1 秒后自动在默认浏览器打开
(sleep 1 && open "http://127.0.0.1:4173") &

node src/server/server.mjs
